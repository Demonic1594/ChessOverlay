<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChessOverlay" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondaryContainer">@color/accent_dim</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/bad</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="materialCardViewStyle">@style/Card</item>
        <item name="chipStyle">@style/ChoiceChip</item>
        <item name="tonalButtonStyle">@style/TonalButton</item>
        <item name="statusChipStyle">@style/StatusChip</item>
    </style>

    <!-- Where the theme says which style Rows.buttons gives its buttons, the status chips, and the icon buttons. -->
    <attr name="tonalButtonStyle" format="reference" />
    <attr name="statusChipStyle" format="reference" />

    <!-- A round button with an icon only (Help, adding an engine). -->
    <style name="IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">?attr/colorControlNormal</item>
    </style>

    <!-- What the overlay needs, as chips: done (a tick) or to do (a warning sign; tapping does it). -->
    <style name="StatusChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipMinHeight">30dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="chipIconSize">16dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipBackgroundColor">@color/surface_high</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- The app's tonal buttons (Change, Options, and the rows Rows.buttons makes). -->
    <style name="TonalButton" parent="Widget.Material3.Button.TonalButton" />

    <style name="ChoiceChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinTouchTargetSize">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <!-- Section titles above the cards. -->
    <style name="Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="Title" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
